test "the greeting loads"
  locale "en-US"
  expect tree has "root"
  expect text "greeting" == "Hello from Apps."

test "the header's button likes it"
  tap "like"
  expect state liked == true

test "Arabic follows the device and a manual choice survives reload"
  locale "ar-EG"
  expect text "counter-title" == "العدّاد المباشر"
  expect text "language-name" == "العربية"
  tap "language-picker"
  tap "language-hi"
  expect text "counter-title" == "लाइव काउंटर"
  reload
  expect text "counter-title" == "लाइव काउंटर"
  expect text "language-name" == "हिन्दी"
  tap "language-picker"
  tap "language-ar"
  expect text "counter-title" == "العدّاد المباشر"
  tap "language-picker"
  tap "language-en"
  expect text "counter-title" == "Live counter"
  expect text "language-name" == "English"
  tap "language-picker"
  tap "language-system"
  expect text "counter-title" == "العدّاد المباشر"
  expect text "language-name" == "العربية"

test "an unsupported device language falls back to English"
  locale "fr-FR"
  expect text "counter-title" == "Live counter"
  expect text "language-name" == "English"
