// Apps: the view. app.ts answers what it asks for. Colours, fonts,
// sizes and the safe area are left unsaid, so each platform supplies its own:
// the header is the navigation bar, its heading the title, its button a bar item.
use ConvexLive from "@exact/convex"

shape Greeting
  text: string

shape Counter
  count: number

shape IncrementReply
  ok: bool

shape AuthReply
  signedIn: bool
  name: string
  google: bool
  error: string

shape GoogleReply
  error: string

routes nav
  home "/"

component Apps
  resource greeting = greeting("Apps") as shape Greeting
  resource live = live() as shape ConvexLive else empty(status="connecting")
  resource counter = counter(live.rev) as shape Counter else empty(count=-1)
  mutation incremented as shape IncrementReply
  mutation checkedSession as shape AuthReply then sessionChecked
  mutation changedSession as shape AuthReply then sessionChanged
  mutation googleBrowser as shape GoogleReply then googleBrowserFinished
  state authReady = false
  state authAttempted = false
  state signedIn = false
  state account = ""
  state googleAvailable = false
  state authError = ""
  state username = ""
  state password = ""
  state creating = false
  derive authChanging = pending(changedSession) or pending(googleBrowser)
  derive authBusy = authChanging or pending(checkedSession)
  state liked = false
  state waited = 0
  state wait = 1
  task restore when not authAttempted
    after(1, checkSession)
  task renew when authReady and not authChanging
    every(30000, checkSession)
  task reconnect when live.status == "closed"
    every(1000, retry)
  task recovered when live.status == "ready" and wait > 1
    after(1000, resetWait)
  action checkSession
    if not authBusy
      authAttempted = true
      send checkedSession = restoreSession()
  action sessionChecked
    match checkedSession
      case some(result)
        if result.error == ""
          authReady = true
          signedIn = result.signedIn
          account = result.name
          googleAvailable = result.google
          authError = ""
        else if not authReady
          authError = result.error
      case none
        authError = "Could not check your session. Try again."
  action sessionChanged
    match changedSession
      case some(result)
        authError = result.error
        if result.error == ""
          signedIn = result.signedIn
          account = result.name
          googleAvailable = result.google
          username = ""
          creating = false
      case none
        authError = "Could not update your session. Try again."
  action editUsername(value: string)
    username = value
  action editPassword(value: string)
    password = value
  action toggleCreate
    creating = not creating
    authError = ""
    password = ""
  action submitPassword
    if not authBusy and username.trim() != "" and password != ""
      authError = ""
      send changedSession = passwordSession(username, password, creating)
      password = ""
  action submitGoogle
    if googleAvailable and not authBusy
      authError = ""
      password = ""
      send googleBrowser = openGoogleSession()
  action cancelGoogle
    if pending(googleBrowser)
      send googleBrowser = cancelGoogleSession()
  action googleBrowserFinished
    match googleBrowser
      case some(result)
        if result.error == ""
          send changedSession = finishGoogleSession()
        else
          authError = result.error
      case none
        authError = "Could not sign in with Google. Try again."
  action logout
    if not authBusy
      authError = ""
      send changedSession = signOut()
  action like
    liked = not liked
  action increment
    if live.status == "ready" and counter.count >= 0 and not pending(incremented)
      send incremented = increment()
  action retry
    if waited + 1 >= wait
      waited = 0
      wait = min(wait * 2, 16)
      refresh live
    else
      waited = waited + 1
  action resetWait
    wait = 1
    waited = 0
  action reconnectNow
    refresh live
    refresh counter
  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "App" role="heading" aria-level=1 flex=1
            button press=like aria-label=(liked ? "Unlike" : "Like") testId="like"
              image (liked ? "symbol:heart-fill" : "symbol:heart")
          scroll id="content" flex=1 min-height=0 padding=16
            column gap=12 align-items="flex-start"
              text greeting.text testId="greeting"
              column gap=10 width="100%" max-width="26.25rem"
                text (signedIn ? "Account" : creating ? "Create an account" : "Sign in") role="heading" aria-level=2 font="-exact-title2"
                if authReady and signedIn
                  text account testId="account-name"
                  button press=logout disabled=authBusy testId="logout"
                    text (pending(changedSession) ? "Signing out…" : "Sign out")
                else if authReady
                  input id="username" value=username input=editUsername autocomplete="username" placeholder="Username" aria-label="Username" testId="username" disabled=authChanging
                  input id="password" type="password" value=password input=editPassword submit=submitPassword autocomplete=(creating ? "new-password" : "current-password") placeholder="Password" aria-label="Password" testId="password" disabled=authChanging
                  if creating
                    text "Use at least 15 characters for your password." font="-exact-footnote" color="-exact-secondary-label"
                  button press=submitPassword disabled=(authBusy or username.trim() == "" or password == "") buttonStyle="filled" testId="password-submit"
                    text (creating ? "Create account" : "Sign in")
                  button press=toggleCreate disabled=authChanging testId="toggle-create"
                    text (creating ? "Back to sign in" : "Create an account")
                  if googleAvailable
                    if pending(googleBrowser)
                      button press=cancelGoogle testId="cancel-google"
                        text "Cancel Google sign-in"
                    else
                      button press=submitGoogle disabled=authBusy testId="google-sign-in"
                        text "Sign in with Google"
                else if authError == ""
                  text "Checking your session…" color="-exact-secondary-label"
                else
                  button press=checkSession disabled=authBusy testId="retry-auth"
                    text "Try again"
                if authError != ""
                  text authError color="-exact-system-red" role="alert" testId="auth-error"
              text "Live counter" role="heading" aria-level=2 font="-exact-title2"
              text (live.status == "closed" ? "Disconnected. Reconnecting…" : live.status == "failed" or failed(counter) ? "Could not load the counter" : live.status == "ready" and counter.count >= 0 ? "Connected to Convex" : "Connecting to Convex…") testId="convex-status"
              if counter.count >= 0
                text `${counter.count}` font="-exact-large-title" testId="convex-count"
              button press=increment disabled=(live.status != "ready" or counter.count < 0 or pending(incremented)) buttonStyle="filled" testId="convex-increment"
                text (pending(incremented) ? "Saving…" : "Increment")
              if failed(incremented)
                text "Could not save the count. Try again." color="-exact-system-red" testId="convex-error"
              if live.status == "failed" or failed(counter)
                button press=reconnectNow
                  text "Retry connection"
