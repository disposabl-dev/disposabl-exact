{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "bun app-platform.ts && bun platforms-build.ts dev",
    "generate:platforms": "bun platforms-build.ts",
    "deploy": "bun run generate:platforms && convex deploy",
    "logs": "convex logs",
    "typecheck": "bun run generate:platforms && tsc -p convex",
    "lint": "npm run typecheck && eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@convex-dev/auth": "2.1.0",
    "@convex-dev/mcp": "0.1.0-alpha.7",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/static-hosting": "0.2.2",
    "@disposabl-kit/server": "link:../disposabl-kit",
    "autumn-js": "1.6.37",
    "convex": "^1.51.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
